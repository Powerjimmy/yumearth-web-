---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const posts = [
  {
    slug: 'why-no-artificial-dyes',
    title: 'Why We Said No to Artificial Dyes — and What We Use Instead',
    date: 'June 2025',
    category: 'Ingredients',
    excerpt: "Most candy gets its color from petroleum-derived dyes. We decided early on that wasn't good enough. Here's how we do it differently.",
  },
  {
    slug: 'is-yumearth-vegan',
    title: "Is YumEarth Vegan? Yes — Here's What's in Every Product",
    date: '2025',
    category: 'Ingredients',
    excerpt: "Every YumEarth product is 100% vegan. No gelatin, no dairy, no shellac, no carmine. Here's the full breakdown by product line.",
  },
  {
    slug: 'is-yumearth-halal',
    title: 'Is YumEarth Halal? What You Need to Know',
    date: '2025',
    category: 'Ingredients',
    excerpt: "YumEarth contains no pork-derived gelatin and no alcohol-based flavor carriers. Here's the full breakdown for halal-conscious shoppers and retailers.",
  },
  {
    slug: 'is-yumearth-healthy',
    title: 'Is YumEarth Healthy? The Honest Answer.',
    date: '2025',
    category: 'Nutrition',
    excerpt: "It's candy — not a health food. But compared to conventional candy, the ingredient difference is real and significant.",
  },
  {
    slug: 'organic-lollipops',
    title: 'Organic Lollipops: What to Look for on the Label',
    date: '2025',
    category: 'Products',
    excerpt: "Not all organic lollipops are equal. Here's what actually matters when choosing organic fruit candy for your family or your store.",
  },
];
---

<Layout
  title="Blog | Organic Candy, Ingredients & Retail Insights | YumEarth EU"
  description="The YumEarth EU blog — organic food, artificial dyes in candy, allergen-friendly ingredients, halal, vegan, and the plant-based movement."
>
  <Nav />
  <main class="pt-32 pb-24">

    <section class="max-w-7xl mx-auto px-6 pb-16">
      <div class="max-w-2xl">
        <p class="text-xs font-black uppercase tracking-widest mb-4" style="color:var(--color-teal);">Blog</p>
        <h1 class="font-black mb-6" style="font-family:'ClashDisplay','Nunito',sans-serif; font-size:clamp(2.5rem,6vw,4.5rem); line-height:0.92; letter-spacing:-0.03em;">
          good reads.<br />
          <span style="color:var(--color-teal);">better candy.</span>
        </h1>
        <p class="text-xl" style="color:var(--color-ink-muted); line-height:1.65;">
          Organic food, sustainability, health — and the occasional sweet obsession.
        </p>
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-6 pb-24">
      <div class="space-y-0 divide-y" style="border-color:rgba(0,0,0,0.08);">
        {posts.map(post => (
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col gap-2 py-8 transition-opacity hover:opacity-70"
            style="text-decoration:none; color:inherit;"
          >
            <div class="flex items-center gap-3">
              <span class="text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full"
                style="background:rgba(0,122,133,0.10); color:var(--color-teal);">
                {post.category}
              </span>
              <span class="text-xs" style="color:var(--color-ink-muted);">{post.date}</span>
            </div>
            <h2 class="font-black" style="font-family:'ClashDisplay','Nunito',sans-serif; font-size:clamp(1.3rem,2.5vw,1.7rem); line-height:1.1; letter-spacing:-0.02em;">
              {post.title}
            </h2>
            <p style="color:var(--color-ink-muted); line-height:1.65; max-width:60ch;">{post.excerpt}</p>
            <span class="text-sm font-bold" style="color:var(--color-teal);">Read →</span>
          </a>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</Layout>
