---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GlobeMap from '../components/react/GlobeMap';

function flag(iso: string) {
  return [...iso.toUpperCase()].map(c =>
    String.fromCodePoint(0x1F1E6 + c.charCodeAt(0) - 65)
  ).join("")
}

const europe = [
  { name: 'Albania',        iso: 'AL' },
  { name: 'Azerbaijan',     iso: 'AZ' },
  { name: 'Belgium',        iso: 'BE' },
  { name: 'Bulgaria',       iso: 'BG' },
  { name: 'Cyprus',         iso: 'CY' },
  { name: 'Czech Republic', iso: 'CZ' },
  { name: 'Denmark',        iso: 'DK' },
  { name: 'Estonia',        iso: 'EE' },
  { name: 'France',         iso: 'FR' },
  { name: 'Georgia',        iso: 'GE' },
  { name: 'Greece',         iso: 'GR' },
  { name: 'Ireland',        iso: 'IE' },
  { name: 'Iceland',        iso: 'IS' },
  { name: 'Kazakhstan',     iso: 'KZ' },
  { name: 'Kosovo',         iso: 'XK' },
  { name: 'Kyrgyzstan',     iso: 'KG' },
  { name: 'Latvia',         iso: 'LV' },
  { name: 'Lithuania',      iso: 'LT' },
  { name: 'Moldova',        iso: 'MD' },
  { name: 'Norway',         iso: 'NO' },
  { name: 'Poland',         iso: 'PL' },
  { name: 'Romania',        iso: 'RO' },
  { name: 'Russia',         iso: 'RU' },
  { name: 'Serbia',         iso: 'RS' },
  { name: 'Slovakia',       iso: 'SK' },
  { name: 'Spain',          iso: 'ES' },
  { name: 'Switzerland',    iso: 'CH' },
  { name: 'Ukraine',        iso: 'UA' },
  { name: 'Uzbekistan',     iso: 'UZ' },
];

const mena = [
  { name: 'Bahrain',      iso: 'BH' },
  { name: 'India',        iso: 'IN' },
  { name: 'Israel',       iso: 'IL' },
  { name: 'Ivory Coast',  iso: 'CI' },
  { name: 'Jordan',       iso: 'JO' },
  { name: 'Kuwait',       iso: 'KW' },
  { name: 'Lebanon',      iso: 'LB' },
  { name: 'Morocco',      iso: 'MA' },
  { name: 'Oman',         iso: 'OM' },
  { name: 'Qatar',        iso: 'QA' },
  { name: 'Saudi Arabia', iso: 'SA' },
  { name: 'UAE',          iso: 'AE' },
  { name: 'Vietnam',      iso: 'VN' },
  { name: 'South Africa', iso: 'ZA' },
];
---

<Layout title="YumEarth EU — Official EMEA Distributor | Organic Candy Wholesale" description="YumEarth EU is the official EMEA master distributor for YumEarth organic candy. Wholesale supply to retailers across 40+ countries in Europe, Middle East and Central Asia.">
  <Nav />
  <main class="pt-32">

    <section class="max-w-7xl mx-auto px-6 pb-20">
      <div class="max-w-2xl">
        <div class="badge mb-6" style="background:rgba(0,178,191,0.12); color:var(--color-teal);">
          Distribution
        </div>
        <h1 class="mb-4" style="font-family:'Nunito',sans-serif; font-weight:900; font-size:clamp(2.5rem,6vw,4.5rem); line-height:0.95; letter-spacing:-0.03em; color:var(--color-ink);">
          Official YumEarth EMEA Distributor
        </h1>
        <p class="text-lg mt-6" style="color:var(--color-ink-muted); line-height:1.7; max-width:580px;">
          YumEarth EU is the official EMEA master distributor for YumEarth organic candy. We supply retailers, distributors and specialty food stores across Europe, the Middle East and Central Asia — from Spain and France to the UAE, Saudi Arabia and Kazakhstan. If you're looking for YumEarth in Europe or the Middle East, you're in the right place.
        </p>
      </div>
    </section>

    <section class="max-w-5xl mx-auto pb-16">
      <GlobeMap client:visible />
    </section>

    <!-- Europe -->
    <section class="py-16" style="background:var(--color-surface);">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-8">
          <span class="text-3xl">🇪🇺</span>
          <h2 class="text-2xl" style="font-family:'Nunito',sans-serif; font-weight:900;">Europe</h2>
        </div>
        <div class="flex flex-wrap gap-3">
          {europe.map(({ name, iso }) => (
            <span
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-bold"
              style="background:white; color:var(--color-ink);"
            >
              <span aria-hidden="true">{flag(iso)}</span>{name}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- MENA -->
    <section class="py-16" style="background:var(--color-cream);">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-8">
          <span class="text-3xl">🌍</span>
          <h2 class="text-2xl" style="font-family:'Nunito',sans-serif; font-weight:900;">Middle East & Other Territories</h2>
        </div>
        <div class="flex flex-wrap gap-3">
          {mena.map(({ name, iso }) => (
            <span
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-bold"
              style="background:white; color:var(--color-ink); border:1px solid rgba(0,0,0,0.06);"
            >
              <span aria-hidden="true">{flag(iso)}</span>{name}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Wholesale CTA -->
    <section class="py-24" style="background:var(--color-surface);">
      <div class="max-w-4xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <p class="text-xs font-black uppercase tracking-widest mb-4" style="color:var(--color-teal);">Wholesale & Import</p>
            <h2 class="font-black mb-4" style="font-family:'ClashDisplay','Nunito',sans-serif; font-size:clamp(2rem,4vw,2.8rem); line-height:0.95; letter-spacing:-0.03em;">
              Bring YumEarth<br />
              <span style="color:var(--color-teal);">to your market.</span>
            </h2>
            <p class="text-base mb-8" style="color:var(--color-ink-muted); line-height:1.7;">
              We work with importers, distributors, and retailers of all sizes. Full product range, competitive wholesale pricing, and import documentation for your country.
            </p>
            <a href="/contact" class="btn-primary">Get wholesale pricing →</a>
          </div>
          <div class="space-y-4">
            {[
              { label: 'USDA Organic certified', desc: 'Full documentation available for customs and import' },
              { label: 'MOQ flexible', desc: 'From specialty stores to national retail chains' },
              { label: 'Allergen-free across the range', desc: 'Safe for schools, hospitals, and mass retail' },
              { label: '40+ countries active', desc: 'Established logistics and distribution network' },
            ].map(item => (
              <div class="flex gap-4 p-5 rounded-2xl" style="background:white; box-shadow:0 1px 6px rgba(0,0,0,0.05);">
                <div class="w-2 h-2 rounded-full mt-2 flex-shrink-0" style="background:var(--color-teal);"></div>
                <div>
                  <p class="font-black text-sm mb-1" style="color:var(--color-ink);">{item.label}</p>
                  <p class="text-sm" style="color:var(--color-ink-muted);">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
